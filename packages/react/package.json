{
  "name": "@node-engine-sdk/react",
  "version": "0.1.0-beta.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruoyu-lab/node-engine-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ruoyu-lab/node-engine-sdk#readme",
  "bugs": {
    "url": "https://github.com/ruoyu-lab/node-engine-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build --config config/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@node-engine-sdk/core": "0.1.0-beta.3"
  },
  "peerDependencies": {
    "@types/react": "^18.3.0 || ^19.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "description": "Official React adapter for Node Engine SDK: the node graph editor component and hooks"
}
