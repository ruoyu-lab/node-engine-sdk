{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@node-engine-sdk/core/protocol": ["../core/src/protocol/index.ts"],
      "@node-engine-sdk/core/view": ["../core/src/view/index.ts"]
    },
    "tsBuildInfoFile": "../../node_modules/.cache/node-engine/react.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "config"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
