{
  "name": "@node-engine-sdk/vue",
  "version": "0.1.0-beta.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruoyu-lab/node-engine-sdk.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/ruoyu-lab/node-engine-sdk#readme",
  "bugs": {
    "url": "https://github.com/ruoyu-lab/node-engine-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vue-tsc -p tsconfig.build.json && vite build --config config/vite.config.ts",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@node-engine-sdk/core": "0.1.0-beta.3"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "description": "Official Vue 3 adapter for Node Engine SDK: the node graph editor component"
}
