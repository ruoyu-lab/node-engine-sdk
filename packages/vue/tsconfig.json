{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@node-wright/core/protocol": ["../core/src/protocol/index.ts"],
      "@node-wright/core/store": ["../core/src/store/index.ts"],
      "@node-wright/core/view": ["../core/src/view/index.ts"]
    },
    "tsBuildInfoFile": "../../node_modules/.cache/node-wright/vue.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"],
  "exclude": ["dist", "config"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
